{
  "name": "local-sharer",
  "productName": "Local Sharer",
  "version": "1.0.0",
  "description": "a file sharer desktop app using electronjs",
  "license": "ISC",
  "author": {
    "name": "Palak Basak",
    "url": "https://github.com/developerpalakbasak"
  },
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "nodemon --ext js,html,css,json --exec electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "morgan": "^1.11.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3"
  },
  "build": {
    "appId": "com.localsharer.app",
    "win": {
      "icon": "assets/icon.ico"
    },
    "linux": {
      "icon": "assets/icon.png"
    }
  }
}

